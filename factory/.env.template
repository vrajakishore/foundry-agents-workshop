# Copy this file to factory/.env, then fill in the two values marked <...>.
# See PREREQUISITES.md, section 10, for where to find them.

PROJECT_CONNECTION_STRING=<your project endpoint>
MODEL_DEPLOYMENT_NAME=gpt-5.4
APPLICATIONINSIGHTS_CONNECTION_STRING=<your Application Insights connection string>
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# Optional. Leave empty to sign in with az login (recommended).
# Use it only if you can't run az login and your project allows API keys (Foundry portal > Home > Project API key).
# A key reaches the model only: smoke_test.py and the Challenge 4 local run use it.
# Creating agents, evaluations and hosted agents still need az login, or the portal steps in each challenge.
FOUNDRY_API_KEY=
